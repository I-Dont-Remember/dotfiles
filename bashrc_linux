if [ -f ~/.bash_aliases_linux ]; then
    . ~/.bash_aliases_linux
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Node
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion


export FLYCTL_INSTALL="$HOME/.fly"
export PATH="$FLYCTL_INSTALL/bin:$PATH"

# Setup for Mise-en-place instead of all the Pyenv,Goenv, etc. language-specific tools
eval "$(mise activate bash)"

# UV!
eval "$(uv generate-shell-completion bash)"

# Go
export GOTOOLCHAIN=local # avoid frustration when 'auto' and it automatically installs newer language versions without consent. I want to manage those explicitly

# Add any extra stuff that's only for WSL linux
if [ -z "${WSL_DISTRO_NAME+x}" ]; then
  : # non-wsl linux variant
else
  . ~/.bashrc_linux_wsl
fi

####################
# Exports
####################
LS_COLORS=$LS_COLORS:'ow=1;34:'; export LS_COLORS

if [ -d /opt/mssql-tools18/bin ]; then
  export PATH="$PATH:/opt/mssql-tools18/bin"
fi
